# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/nomorku_bridge

# =============================================================================
# REDIS (used for idempotency and BullMQ)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# DOKU PAYMENT GATEWAY
# Get these from: https://dashboard.doku.com
# =============================================================================
DOKU_CLIENT_ID=your-doku-client-id
DOKU_SECRET_KEY=your-doku-secret-key
DOKU_BASE_URL=https://sandbox.doku.com

# =============================================================================
# CAPTCHA (Cloudflare Turnstile)
# =============================================================================
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key

# =============================================================================
# FRONTEND URL (needed for DOKU redirect after payment and CORS)
# =============================================================================
FE_BASE_URL=http://localhost:3000
FRONTEND_URL=https://your-app.vercel.app

# =============================================================================
# ERPNEXT / FRAPPE
# =============================================================================
ERP_BASE_URL=https://erp.yourdomain.com
ERP_API_KEY=your-erp-api-key
ERP_API_SECRET=your-erp-api-secret
ERP_COMPANY=Akrilo Creations
ERP_WAREHOUSE=Finished Goods - AC
ERP_SELLING_PRICE_LIST=Standard Selling
ERP_CURRENCY=IDR

# =============================================================================
# MAILTRAP (order confirmation email)
# sandbox    -> email ditangkap di inbox virtual, TIDAK sampai ke penerima asli
#               Get API token + inbox ID from: https://mailtrap.io -> Email Testing -> Inbox -> API/SMTP settings
# production -> email benar-benar terkirim; wajib domain terverifikasi + token Email Sending
#               (berbeda dari token Email Testing) dari https://mailtrap.io -> Email Sending
# =============================================================================
MAILTRAP_MODE=sandbox
MAILTRAP_API_TOKEN=your-mailtrap-api-token
MAILTRAP_INBOX_ID=your-mailtrap-inbox-id
MAILTRAP_FROM_EMAIL=no-reply@your-verified-domain.com
MAILTRAP_FROM_NAME=Akrilo Creations
DESIGN_URL=https://design.akrilocreations.com

# =============================================================================
# SERVER
# =============================================================================
PORT=3000
NODE_ENV=development
